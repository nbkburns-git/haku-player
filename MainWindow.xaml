<Window x:Class="AnimePlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AnimePlayer"
        Title="Haku Player" Icon="Assets/haku.ico" Width="1600" Height="950" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="Transparent" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Display, Segoe UI"
        PreviewKeyDown="OnKey" PreviewTextInput="OnText" Closing="OnClosing">
  <!-- No OS title bar: the header row is the drag area, edges still resize, DWM paints the glass behind us -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="7" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <local:FavConverter x:Key="Fav"/>
    <local:WatchConverter x:Key="Watch"/>
    <!-- small round star button (favourite) -->
    <Style x:Key="StarBtn" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="R" RenderTransformOrigin="0.5,0.5" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="R" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.15" ScaleY="1.15"/></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="R" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Cover card: placeholder (gradient + name) under the cover; hover lifts it, deepens the shadow and sweeps a sheen across -->
    <ControlTemplate x:Key="CardTemplate" TargetType="Button">
      <StackPanel Width="210" Background="Transparent">
        <StackPanel.CacheMode><BitmapCache RenderAtScale="1.1" SnapsToDevicePixels="True"/></StackPanel.CacheMode>
        <Grid x:Name="Lift" Height="315" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform>
            <TransformGroup>
              <ScaleTransform x:Name="S"/>
              <TranslateTransform x:Name="T"/>
            </TransformGroup>
          </Grid.RenderTransform>
          <Border x:Name="Shadow" CornerRadius="18" Background="#C0000000" Margin="10,16,10,4" Opacity="0.5">
            <Border.CacheMode><BitmapCache/></Border.CacheMode>
            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="14" Opacity="0.7"/></Border.Effect>
          </Border>
          <Border CornerRadius="18" ClipToBounds="True">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#40465A" Offset="0"/>
                <GradientStop Color="#1A1C26" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                       Margin="16" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
          </Border>
          <Border CornerRadius="18">
            <Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/></Border.Background>
          </Border>
          <!-- Random slot face -->
          <Border CornerRadius="18" Visibility="{Binding IsRandom, Converter={StaticResource BoolVis}}" Background="{DynamicResource AccentGrad}">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="&#xE8B1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="64" HorizontalAlignment="Center"/>
              <TextBlock Text="Random" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
              <TextBlock Text="Next = another random one" FontSize="13" Opacity="0.85" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
          <!-- sheen sweep, clipped to the card -->
          <Border IsHitTestVisible="False">
            <Border.Clip><RectangleGeometry Rect="0,0,210,315" RadiusX="18" RadiusY="18"/></Border.Clip>
            <Rectangle x:Name="Sheen" Fill="{StaticResource Sheen}" Width="420" Height="315" HorizontalAlignment="Left" Opacity="0">
              <Rectangle.RenderTransform><TranslateTransform x:Name="SheenX" X="-420"/></Rectangle.RenderTransform>
            </Rectangle>
          </Border>
          <Border CornerRadius="18" BorderThickness="1" BorderBrush="{StaticResource GlassStroke}" IsHitTestVisible="False"/>
          <!-- glass star: frosted body + bright rim (no backdrop circle); gold and glowing when favourite -->
          <Button x:Name="Star" Style="{StaticResource StarBtn}" Click="OnStar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                  Width="46" Height="46" ToolTip="Favourite" AutomationProperties.Name="Star">
            <Grid Width="46" Height="46">
              <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{Binding Converter={StaticResource Fav}, ConverterParameter=fill}">
                <TextBlock.Effect><DropShadowEffect Color="#FFC83D" BlurRadius="14" ShadowDepth="0" Opacity="{Binding Converter={StaticResource Fav}, ConverterParameter=glow}"/></TextBlock.Effect>
              </TextBlock>
              <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F2FFFFFF">
                <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="1" Opacity="0.75"/></TextBlock.Effect>
              </TextBlock>
            </Grid>
          </Button>
        </Grid>
        <TextBlock Text="{Binding Name}" Margin="6,14,6,0" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Converter={StaticResource Watch}}" Margin="6,3,6,0" FontSize="13" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Y" To="-10" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"/>
                <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                <DoubleAnimation Storyboard.TargetName="SheenX" Storyboard.TargetProperty="X" From="-420" To="210" Duration="0:0:0.7"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
        <DataTrigger Binding="{Binding IsRandom}" Value="True">
          <Setter TargetName="Star" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="Lift" Property="Opacity" Value="0.85"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <DataTemplate x:Key="Card">
      <Button Template="{StaticResource CardTemplate}" Click="OnCard" Margin="16,16,16,22" Cursor="Hand" Focusable="False" Foreground="{StaticResource Text}" AutomationProperties.Name="{Binding Name}"/>
    </DataTemplate>

    <!-- Home panels: rounded glass edge; content is clipped to the corners in code; hover lifts it a touch -->
    <LinearGradientBrush x:Key="PanelScrim" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#400A0B10" Offset="0"/>
      <GradientStop Color="#600A0B10" Offset="0.45"/>
      <GradientStop Color="#EE0A0B10" Offset="1"/>
    </LinearGradientBrush>
    <ControlTemplate x:Key="PanelTemplate" TargetType="Button">
      <Grid x:Name="R" RenderTransformOrigin="0.5,0.5" Background="Transparent">
        <Grid.RenderTransform><ScaleTransform x:Name="S"/></Grid.RenderTransform>
        <ContentPresenter/>
        <Border x:Name="Edge" CornerRadius="28" BorderThickness="1" BorderBrush="{StaticResource GlassStroke}" Opacity="0.6" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.35"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.35"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.4"/>
                <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.4"/>
                <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.3"/>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

  </Window.Resources>

  <Grid x:Name="Shell">
    <!-- Backdrop: dark tint over the OS acrylic, drifting colour blobs, and (on a show page) its blurred cover -->
    <Border x:Name="Tint" Background="#B80A0B10"/>
    <Canvas x:Name="Blobs" ClipToBounds="True" IsHitTestVisible="False"/>
    <Image x:Name="Ambient" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="Linear"/>
    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#00000000" Offset="0.4"/>
          <GradientStop Color="#70000000" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Grid x:Name="Content">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>

      <!-- HEADER: drag region + back + title + window controls -->
      <DockPanel x:Name="Header" Height="52" Margin="18,0,10,0" Panel.ZIndex="1">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource Caption}" Click="OnSearchAll" ToolTip="Search everything" Content="&#xE721;" FontSize="14" Margin="0,0,4,0" AutomationProperties.Name="Search everything"/>
          <Button Style="{StaticResource Caption}" Click="OnSync" ToolTip="Sync library (rescan for new shows and openings)" FontSize="14" Margin="0,0,4,0" AutomationProperties.Name="Sync library">
            <TextBlock Text="&#xE72C;" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform x:Name="SyncSpin"/></TextBlock.RenderTransform></TextBlock>
          </Button>
          <Button Style="{StaticResource Caption}" Click="OnOpenSettings" ToolTip="Settings" Content="&#xE713;" FontSize="14" Margin="0,0,10,0" AutomationProperties.Name="App settings"/>
          <Button Style="{StaticResource Caption}" Click="OnMinimize" ToolTip="Minimize" Content="&#xE921;"/>
          <Button x:Name="MaxBtn" Style="{StaticResource Caption}" Click="OnMaximize" ToolTip="Maximize" Content="&#xE922;" Margin="4,0" AutomationProperties.Name="Header maximize"/>
          <Button Style="{StaticResource Caption}" Click="OnCloseWindow" ToolTip="Close" Content="&#xE8BB;" Tag="Close"/>
        </StackPanel>
        <Button x:Name="BackBtn" Style="{StaticResource Back}" Click="OnBack" Visibility="Collapsed" Margin="0,0,16,0"
                VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Image x:Name="Logo" Source="Assets/logo.png" Width="24" Height="24" VerticalAlignment="Center" Margin="2,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="HeaderTitle" Text="Haku Player" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}"/>
      </DockPanel>

      <Grid Grid.Row="1">
        <!-- HOME: Mincho wordmark, "Continue watching" banner, then Shows and Openings as panels of drifting covers -->
        <Grid x:Name="Home" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <!-- wordmark: Shippori Mincho with a soft accent glow, and a red hanko-style seal -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
            <TextBlock Text="Haku Player" FontFamily="{StaticResource Mincho}" FontSize="72" FontWeight="ExtraBold" VerticalAlignment="Center">
              <TextBlock.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="40" ShadowDepth="0" Opacity="0.55"/></TextBlock.Effect>
            </TextBlock>
            <Border Width="50" Height="62" CornerRadius="9" Background="{DynamicResource AccentGrad}" Margin="20,8,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><RotateTransform Angle="-5"/></Border.RenderTransform>
              <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45"/></Border.Effect>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ハ" FontFamily="{StaticResource Mincho}" FontSize="21" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,-4"/>
                <TextBlock Text="ク" FontFamily="{StaticResource Mincho}" FontSize="21" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- continue watching: every show you're part-way through (or onto the next episode of), newest first -->
          <ScrollViewer x:Name="ContinueRow" Grid.Row="2" Margin="62,-18,62,40" Visibility="Collapsed" HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnContinueWheel" Focusable="False">
            <StackPanel x:Name="ContinueItems" Orientation="Horizontal"/>
          </ScrollViewer>

          <!-- categories: glass panels with slowly drifting walls of covers -->
          <UniformGrid Grid.Row="1" Columns="2" Margin="40,22,40,40">
            <Button x:Name="ShowsTile" Template="{StaticResource PanelTemplate}" Click="OnTile" Tag="Shows" Margin="22,0" Cursor="Hand" Focusable="False" Foreground="{StaticResource Text}" AutomationProperties.Name="Shows and Movies">
              <Grid x:Name="ShowsBody">
                <Canvas x:Name="ShowsWall" ClipToBounds="True"/>
                <Rectangle Fill="{StaticResource PanelScrim}"/>
                <DockPanel VerticalAlignment="Bottom" Margin="32,0,30,28">
                  <TextBlock DockPanel.Dock="Right" Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" VerticalAlignment="Bottom" Margin="0,0,0,8" Opacity="0.85"/>
                  <StackPanel>
                    <TextBlock Text="Shows and Movies" FontSize="42" FontWeight="Bold"/>
                    <TextBlock x:Name="ShowsCount" FontSize="16" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Grid>
            </Button>
            <Button x:Name="OpsTile" Template="{StaticResource PanelTemplate}" Click="OnTile" Tag="Openings" Margin="22,0" Cursor="Hand" Focusable="False" Foreground="{StaticResource Text}" AutomationProperties.Name="Openings">
              <Grid x:Name="OpsBody">
                <Canvas x:Name="OpsWall" ClipToBounds="True"/>
                <Rectangle Fill="{StaticResource PanelScrim}"/>
                <DockPanel VerticalAlignment="Bottom" Margin="32,0,30,28">
                  <TextBlock DockPanel.Dock="Right" Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" VerticalAlignment="Bottom" Margin="0,0,0,8" Opacity="0.85"/>
                  <StackPanel>
                    <TextBlock Text="Openings / Endings" FontSize="42" FontWeight="Bold"/>
                    <TextBlock x:Name="OpsCount" FontSize="16" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Grid>
            </Button>
          </UniformGrid>
        </Grid>

        <!-- GRID of covers -->
        <DockPanel x:Name="Library" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Top" Margin="64,10,48,10">
            <Grid DockPanel.Dock="Right" Width="400" VerticalAlignment="Center">
              <Border CornerRadius="21" Background="{StaticResource GlassFill}" BorderThickness="1" BorderBrush="{StaticResource GlassStroke}"/>
              <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Margin="17,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="SearchHint" Text="Search shows, openings, episodes" FontSize="15" Margin="46,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"/>
              <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" CaretBrush="White" FontSize="15"
                       Padding="42,12,16,12" TextChanged="OnSearch" AutomationProperties.Name="Search box"/>
            </Grid>
            <TextBlock x:Name="LibraryTitle" FontSize="40" FontWeight="Bold" VerticalAlignment="Center"/>
          </DockPanel>
          <WrapPanel x:Name="FilterBar" DockPanel.Dock="Top" Margin="62,0,48,6"/>
          <ScrollViewer x:Name="LibScroll" VerticalScrollBarVisibility="Auto" Padding="40,0,26,20">
            <ItemsControl x:Name="Cards" ItemTemplate="{StaticResource Card}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- DETAIL: banner, big cover + facts, title, genres, description, then the list -->
        <Grid x:Name="Detail" Visibility="Collapsed">
          <!-- banner spans the page and is fully faded out by about half way, so it never ends in a hard edge or shows behind the list -->
          <Image x:Name="DetailBanner" Margin="0,-52,0,0" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"
                 RenderOptions.BitmapScalingMode="HighQuality">
            <Image.OpacityMask>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#C0000000" Offset="0"/>
                <GradientStop Color="#78000000" Offset="0.2"/>
                <GradientStop Color="#30000000" Offset="0.34"/>
                <GradientStop Color="#0C000000" Offset="0.44"/>
                <GradientStop Color="#00000000" Offset="0.52"/>
              </LinearGradientBrush>
            </Image.OpacityMask>
          </Image>
          <Border Margin="0,-52,0,0" IsHitTestVisible="False">
            <Border.OpacityMask>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF000000" Offset="0.3"/>
                <GradientStop Color="#00000000" Offset="0.55"/>
              </LinearGradientBrush>
            </Border.OpacityMask>
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                <GradientStop Color="#C00A0B10" Offset="0"/>
                <GradientStop Color="#700A0B10" Offset="0.5"/>
                <GradientStop Color="#300A0B10" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Grid Margin="56,6,48,36">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>

            <!-- left: big cover (shrinks on small windows) + facts -->
            <Viewbox Width="380" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
              <StackPanel Width="380">
                <Grid Width="380" Height="570">
                  <Border CornerRadius="26" Background="#C0000000" Margin="12,20,12,4">
                    <Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="18" Opacity="0.6"/></Border.Effect>
                    <Border.CacheMode><BitmapCache/></Border.CacheMode>
                  </Border>
                  <Border CornerRadius="26">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#40465A" Offset="0"/>
                        <GradientStop Color="#1A1C26" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="24" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                  </Border>
                  <Border CornerRadius="26" BorderThickness="1" BorderBrush="{StaticResource GlassStroke}">
                    <Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/></Border.Background>
                  </Border>
                </Grid>
                <StackPanel x:Name="Facts" Margin="6,26,6,0"/>
              </StackPanel>
            </Viewbox>

            <!-- right: title, alt title, genres, description, list -->
            <DockPanel Grid.Column="1" Margin="46,10,0,0">
              <DockPanel DockPanel.Dock="Top">
                <Button x:Name="DetailStar" DockPanel.Dock="Right" Style="{StaticResource StarBtn}" Click="OnDetailStar" FontSize="30" Foreground="#FFD54F"
                        Margin="18,6,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="&#xE734;" ToolTip="Favourite" AutomationProperties.Name="Favourite show"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Click="OnFixOpen" VerticalAlignment="Center" Margin="18,8,0,0" Cursor="Hand"
                        ToolTip="Details are for a different show? Pick the right one" AutomationProperties.Name="Wrong show info">
                  <StackPanel Orientation="Horizontal" Opacity="0.7">
                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Wrong show info?" FontSize="13.5" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <TextBlock Text="{Binding Name}" FontSize="48" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <TextBlock x:Name="DetailAlt" DockPanel.Dock="Top" FontSize="17" Foreground="#C8CCD6" Margin="2,4,0,0" TextTrimming="CharacterEllipsis"/>
              <WrapPanel x:Name="DetailGenres" DockPanel.Dock="Top" Margin="0,14,0,0"/>
              <StackPanel DockPanel.Dock="Top" Margin="2,16,0,0">
                <TextBlock x:Name="DetailDesc" FontSize="15.5" LineHeight="24" TextWrapping="Wrap" MaxHeight="120" TextTrimming="WordEllipsis" Foreground="#D8DCE4" MaxWidth="1100" HorizontalAlignment="Left"/>
                <Button x:Name="DescMore" Style="{StaticResource Flat}" Click="OnDescMore" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.Name="Description more">
                  <TextBlock x:Name="DescMoreText" Text="More" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                </Button>
              </StackPanel>
              <DockPanel DockPanel.Dock="Top" Margin="4,22,0,10">
                <!-- inside a season: back to the season list -->
                <Button x:Name="SeasonBack" DockPanel.Dock="Left" Style="{StaticResource Flat}" Click="OnSeasonBack" Visibility="Collapsed" Margin="0,0,12,0" Cursor="Hand" AutomationProperties.Name="All seasons">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="All seasons" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <!-- compares your files with the show's official episode list -->
                <TextBlock x:Name="DetailCount" DockPanel.Dock="Left" FontSize="13" FontWeight="Bold" Opacity="0.55" VerticalAlignment="Center"/>
                <Button x:Name="MissingBtn" Style="{StaticResource Flat}" Click="OnMissing" HorizontalAlignment="Left" Margin="14,0,0,0" Cursor="Hand" Visibility="Collapsed"
                        ToolTip="See which seasons or episodes you don't have" AutomationProperties.Name="What's missing">
                  <StackPanel Orientation="Horizontal" Opacity="0.75">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="What's missing" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="MarkAllBtn" Style="{StaticResource Flat}" Click="OnMarkAll" HorizontalAlignment="Left" Margin="14,0,0,0" Cursor="Hand" Visibility="Collapsed"
                        AutomationProperties.Name="Mark all watched">
                  <StackPanel Orientation="Horizontal" Opacity="0.75">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="MarkAllText" Text="Mark all watched" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Popup x:Name="MissingPopup" PlacementTarget="{Binding ElementName=MissingBtn}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                  <!-- the shared liquid glass panel (App.xaml GlassPanel), same as tooltips -->
                  <ContentControl Style="{StaticResource GlassPanel}" Margin="10" MaxWidth="460" Padding="20,16,20,16">
                    <StackPanel x:Name="MissingItems"/>
                  </ContentControl>
                </Popup>
              </DockPanel>
              <Grid VerticalAlignment="Top">
                <Border CornerRadius="26" Background="{StaticResource GlassFill}" BorderThickness="1" BorderBrush="{StaticResource GlassStroke}" Padding="20,18,10,18">
                  <ScrollViewer x:Name="VideoScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                    <!-- a show with several seasons lists them first -->
                    <StackPanel x:Name="SeasonList" Visibility="Collapsed"/>
                    <ItemsControl x:Name="Videos">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource Row}" Click="OnVideo" AutomationProperties.Name="{Binding Title}" Padding="18,14" Margin="0,4" HorizontalContentAlignment="Stretch">
                            <Grid>
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Num}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Accent}" Width="44" VerticalAlignment="Center"
                                           Opacity="{Binding Converter={StaticResource Watch}, ConverterParameter=dim}"/>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource StarBtn}" Click="OnStar" Width="34" Height="30" Margin="0,0,14,0"
                                        Content="{Binding Converter={StaticResource Fav}}" FontSize="17" Foreground="{Binding Converter={StaticResource Fav}, ConverterParameter=color}" ToolTip="Favourite" AutomationProperties.Name="Star row"/>
                                <!-- watched tick: accent when watched, faint when not; click to toggle -->
                                <Button DockPanel.Dock="Right" Style="{StaticResource StarBtn}" Click="OnWatchedToggle" Width="34" Height="30" Margin="0,0,4,0"
                                        Content="&#xE73E;" FontSize="16" Foreground="{Binding Converter={StaticResource Watch}, ConverterParameter=color}"
                                        ToolTip="{Binding Converter={StaticResource Watch}, ConverterParameter=tip}" AutomationProperties.Name="Watched row"/>
                                <TextBlock Text="{Binding Title}" FontSize="17" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Opacity="{Binding Converter={StaticResource Watch}, ConverterParameter=dim}"/>
                              </DockPanel>
                              <!-- how far into this episode you are -->
                              <Grid VerticalAlignment="Bottom" Height="3" Margin="44,0,0,-9" Visibility="{Binding Converter={StaticResource Watch}, ConverterParameter=bar}">
                                <Border CornerRadius="2" Background="#30FFFFFF"/>
                                <Border CornerRadius="2" Background="{DynamicResource AccentGrad}" RenderTransformOrigin="0,0.5">
                                  <Border.RenderTransform><ScaleTransform ScaleX="{Binding Converter={StaticResource Watch}, ConverterParameter=progress}"/></Border.RenderTransform>
                                </Border>
                              </Grid>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </DockPanel>
          </Grid>
        </Grid>

        <!-- PLAYER: mpv renders into this WinForms panel -->
        <Grid x:Name="Player" Visibility="Collapsed" Background="Black">
          <WindowsFormsHost x:Name="VideoHost">
            <local:PassPanel x:Name="VideoPanel" BackColor="Black"/>
          </WindowsFormsHost>
        </Grid>
      </Grid>
    </Grid>

    <!-- TOAST: short glass message (library sync) -->
    <ContentControl x:Name="ToastBox" Style="{StaticResource GlassPanel}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,36" Opacity="0" IsHitTestVisible="False"
                    Padding="22,11" Panel.ZIndex="5">
      <ContentControl.RenderTransform><TranslateTransform x:Name="ToastShift"/></ContentControl.RenderTransform>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,1,10,0"/>
        <TextBlock x:Name="ToastText" FontSize="15" VerticalAlignment="Center"/>
      </StackPanel>
    </ContentControl>

    <!-- WRONG SHOW?: search AniList and pick the right entry for this folder -->
    <Grid x:Name="FixLayer" Visibility="Collapsed" Background="#88050608" MouseLeftButtonDown="OnFixBackdrop">
      <ContentControl Style="{StaticResource GlassPanel}" Width="640" MaxHeight="660" Margin="40,70,40,40" Padding="26,22,18,22">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Style="{StaticResource Caption}" Click="OnFixClose" Content="&#xE8BB;" Tag="Close" ToolTip="Close (Esc)" AutomationProperties.Name="Close fix match"/>
            <TextBlock Text="Find the right show" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Search and pick the correct entry (AniList for anime, IMDb via Cinemeta for TV and movies). Haku Player remembers your choice for this folder." FontSize="13"
                     Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,8,14"/>
          <Grid DockPanel.Dock="Top" Height="44" Margin="0,0,8,12">
            <Border CornerRadius="22" Background="{StaticResource GlassFill}" BorderThickness="1" BorderBrush="{StaticResource GlassStroke}"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Margin="17,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
            <TextBox x:Name="FixSearch" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" CaretBrush="White" FontSize="15"
                     Padding="42,12,16,12" KeyDown="OnFixKey" AutomationProperties.Name="Fix match search"/>
          </Grid>
          <TextBlock x:Name="FixStatus" DockPanel.Dock="Top" FontSize="13" Foreground="{StaticResource Muted}" Margin="4,0,0,8" Visibility="Collapsed"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel x:Name="FixResults"/>
          </ScrollViewer>
        </DockPanel>
      </ContentControl>
    </Grid>

    <!-- SETTINGS: dimmed backdrop + glass card -->
    <Grid x:Name="SettingsLayer" Visibility="Collapsed" Background="#33050608" MouseLeftButtonDown="OnSettingsBackdrop">
      <Grid x:Name="SettingsCard" MaxWidth="940" MaxHeight="700" Margin="40,70,40,40" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="SettingsScale"/></Grid.RenderTransform>
        <!-- glass layers (shadow, sheen, rims) are added in code; the page behind is blurred while open -->
        <Border CornerRadius="28" Padding="30,24,22,24">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
              <GradientStop Color="#40FFFFFF" Offset="0"/>
              <GradientStop Color="#10FFFFFF" Offset="0.5"/>
              <GradientStop Color="#18FFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
              <Button DockPanel.Dock="Right" Style="{StaticResource Caption}" Click="OnCloseSettings" Content="&#xE8BB;" Tag="Close" ToolTip="Close (Esc)" AutomationProperties.Name="Close settings"/>
              <Image Source="Assets/logo.png" Width="30" Height="30" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <!-- sections on the left, the chosen section's settings on the right -->
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel x:Name="SettingsNav" Margin="0,0,16,0"/>
              <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="#1FFFFFFF" Padding="24,0,0,0">
                <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                  <StackPanel x:Name="SettingsItems"/>
                </ScrollViewer>
              </Border>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- LOADING: breathing logo, spinning glass ring -->
    <Grid x:Name="Splash" Background="#E60A0B10" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform><ScaleTransform x:Name="SplashScale"/></Grid.RenderTransform>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid Width="200" Height="200">
          <Ellipse Width="190" Height="190" StrokeThickness="3" Stroke="#18FFFFFF"/>
          <Ellipse Width="190" Height="190" StrokeThickness="3" StrokeDashArray="18 60" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF7A8C" Offset="0"/><GradientStop Color="#3A5BFF" Offset="1"/></LinearGradientBrush></Ellipse.Stroke>
            <Ellipse.RenderTransform><RotateTransform x:Name="SplashRot"/></Ellipse.RenderTransform>
          </Ellipse>
          <Image Source="Assets/logo.png" Width="120" Height="120" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect><DropShadowEffect Color="#C23BD0" BlurRadius="60" ShadowDepth="0" Opacity="0.7"/></Image.Effect>
            <Image.RenderTransform><ScaleTransform x:Name="SplashPulse"/></Image.RenderTransform>
          </Image>
        </Grid>
        <TextBlock Text="Haku Player" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,0"/>
        <TextBlock Text="Loading your library…" FontSize="15" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
