<Application x:Class="AnimePlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0E0F13"/>
    <SolidColorBrush x:Key="Panel" Color="#181A21"/>
    <SolidColorBrush x:Key="Accent" Color="#E8475F"/>
    <SolidColorBrush x:Key="Text" Color="#F2F3F7"/>
    <SolidColorBrush x:Key="Muted" Color="#A3A8B5"/>
    <!-- bundled Japanese display font (Shippori Mincho ExtraBold) -->
    <FontFamily x:Key="Mincho">pack://application:,,,/Assets/Fonts/#Shippori Mincho</FontFamily>

    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF7A8C" Offset="0"/>
      <GradientStop Color="#E8475F" Offset="0.6"/>
      <GradientStop Color="#C23BD0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Glass: faint white fill, bright top edge fading out, like light catching a pane -->
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0.4,1">
      <GradientStop Color="#1FFFFFFF" Offset="0"/>
      <GradientStop Color="#0CFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassFillHover" StartPoint="0,0" EndPoint="0.4,1">
      <GradientStop Color="#33FFFFFF" Offset="0"/>
      <GradientStop Color="#14FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#66FFFFFF" Offset="0"/>
      <GradientStop Color="#14FFFFFF" Offset="0.45"/>
      <GradientStop Color="#0AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Sheen" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#00FFFFFF" Offset="0.3"/>
      <GradientStop Color="#38FFFFFF" Offset="0.5"/>
      <GradientStop Color="#00FFFFFF" Offset="0.7"/>
    </LinearGradientBrush>

    <!-- Base button: no chrome, hand cursor -->
    <Style x:Key="Flat" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Glass pill button (Back, list rows): brightens and lifts on hover, presses in on click -->
    <Style x:Key="Glass" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="R" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="S"/></Grid.RenderTransform>
              <Border x:Name="Shadow" CornerRadius="14" Background="#40000000" Margin="2" Opacity="0.6">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45"/></Border.Effect>
              </Border>
              <Border x:Name="B" CornerRadius="14" Background="{StaticResource GlassFill}" BorderThickness="1" BorderBrush="{StaticResource GlassStroke}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource GlassFillHover}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.25"/>
                      <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25"/>
                      <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="R" Property="Opacity" Value="0.75"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- List row: stays inside its panel; hover brightens it, lights an accent bar and nudges the text right -->
    <Style x:Key="Row" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="14" Background="#0DFFFFFF" BorderThickness="1" BorderBrush="#14FFFFFF">
              <Grid>
                <Border x:Name="Hi" CornerRadius="14" Background="{StaticResource GlassFillHover}" Opacity="0"/>
                <Border x:Name="Bar" Width="4" CornerRadius="2" Margin="6,12" HorizontalAlignment="Left" Background="{DynamicResource AccentGrad}" Opacity="0">
                  <Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
                </Border>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                  <ContentPresenter.RenderTransform><TranslateTransform x:Name="Nudge"/></ContentPresenter.RenderTransform>
                </ContentPresenter>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource GlassStroke}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                      <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                      <DoubleAnimation Storyboard.TargetName="Nudge" Storyboard.TargetProperty="X" To="6" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                      <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                      <DoubleAnimation Storyboard.TargetName="Nudge" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.75"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Item in the glass popup menus -->
    <Style x:Key="MenuItem" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#22FFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#33FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Small pill choice in settings rows; Tag="On" marks the selected one -->
    <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="11" Padding="10,4" Background="#1AFFFFFF" BorderThickness="1" BorderBrush="#22FFFFFF">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#33FFFFFF"/></Trigger>
              <Trigger Property="Tag" Value="On">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentGrad}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="#66FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Back" TargetType="Button" BasedOn="{StaticResource Glass}">
      <Setter Property="Padding" Value="12,5,16,5"/>
      <Setter Property="ToolTip" Value="Back (Esc / Backspace)"/>
      <Setter Property="Content" Value="Back"/>
      <!-- a template, not shared content: every Back button gets its own copy -->
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0"/>
            <TextBlock Text="Back" FontSize="15"/>
          </StackPanel>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Icon button (player bar): no disc; on hover the icon brightens, glows softly, grows a touch, and an accent dot appears -->
    <Style x:Key="Icon" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="R" Background="Transparent" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="S"/></Grid.RenderTransform>
              <ContentPresenter x:Name="C" Opacity="0.82" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter.Effect><DropShadowEffect Color="White" BlurRadius="16" ShadowDepth="0" Opacity="0"/></ContentPresenter.Effect>
              </ContentPresenter>
              <Border x:Name="Dot" Width="4" Height="4" CornerRadius="2" Background="{DynamicResource AccentGrad}" VerticalAlignment="Bottom" Margin="0,0,0,2" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="C" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                      <DoubleAnimation Storyboard.TargetName="C" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.75" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1.14" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1.14" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="C" Storyboard.TargetProperty="Opacity" To="0.82" Duration="0:0:0.25"/>
                      <DoubleAnimation Storyboard.TargetName="C" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.25"/>
                      <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                      <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25"/>
                      <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="R" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Window caption buttons: quiet until hovered, then brighten with a soft glow; Close glows red -->
    <Style x:Key="Caption" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="R" Background="Transparent" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="S"/></Grid.RenderTransform>
              <ContentPresenter x:Name="C" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter.Effect><DropShadowEffect Color="White" BlurRadius="12" ShadowDepth="0" Opacity="0"/></ContentPresenter.Effect>
              </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="C" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.7" Duration="0:0:0.15"/>
                      <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.15"/>
                      <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.15"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="C" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="Tag" Value="Close"/>
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="#FF6B6B"/>
              </MultiTrigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="R" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- THE liquid glass panel for anything that floats (tooltips, pop-ups, flyouts): see-through tint, a top sheen,
         a bright specular rim, and a soft shadow on the text so it reads over anything. Use this for every new pop-up;
         never give a floating panel its own solid background. No drop shadow: under translucent glass it only darkens it. -->
    <Style x:Key="GlassPanel" TargetType="ContentControl">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Grid>
              <!-- tint: light enough to see through, dark enough to read -->
              <Border CornerRadius="14">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                    <GradientStop Color="#8C2C3040" Offset="0"/>
                    <GradientStop Color="#A0101219" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <!-- sheen across the top -->
              <Border CornerRadius="14">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#30FFFFFF" Offset="0"/>
                    <GradientStop Color="#08FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <!-- specular rim: bright top-left, fading, faint glint bottom-right -->
              <Border CornerRadius="14" BorderThickness="1">
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#99FFFFFF" Offset="0"/>
                    <GradientStop Color="#1FFFFFFF" Offset="0.4"/>
                    <GradientStop Color="#14FFFFFF" Offset="0.7"/>
                    <GradientStop Color="#4DFFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.BorderBrush>
              </Border>
              <ContentPresenter Margin="{TemplateBinding Padding}">
                <ContentPresenter.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.7"/></ContentPresenter.Effect>
              </ContentPresenter>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tooltips use the shared glass panel -->
    <Style TargetType="ToolTip">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <ContentControl Style="{StaticResource GlassPanel}" Margin="10" Padding="13,7" Content="{TemplateBinding Content}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim glass scrollbar -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="18"/>
      <Setter Property="MinWidth" Value="18"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border CornerRadius="7" Background="#10FFFFFF" Margin="3,6">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="T" CornerRadius="5" Background="#55FFFFFF" MinHeight="40"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#80FFFFFF"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
