<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- off: WPF + WinForms implicit usings clash (Button, Application, ...) -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HakuPlayer</AssemblyName>
    <Product>Haku Player</Product>
    <ApplicationIcon>Assets\haku.ico</ApplicationIcon>
    <!-- optimized code even in the everyday (Debug) build, which keeps its output folder and data -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <!-- Outfit (SIL Open Font License, see Assets\Fonts\OFL-Outfit.txt): the home page wordmark -->
    <Resource Include="Assets\Fonts\Outfit-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Outfit-Light.ttf" />
    <None Include="Assets\Fonts\OFL-Outfit.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\glass.glsl" CopyToOutputDirectory="PreserveNewest" />
    <!-- mpv as a library (shinchiro build 20261021, git e471496c56): it draws the video into our own window -->
    <None Include="lib\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- the AI upscaler's own code (native\haku_sr, built by its build.cmd into lib\): travels with the app, so it always
         matches it; the big TensorRT runtime and the models stay in %LOCALAPPDATA%\Haku Upscaler -->
    <None Include="lib\haku_sr.dll" Link="haku_sr.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('lib\haku_sr.dll')" />
  </ItemGroup>
  <ItemGroup>
    <!-- tools\ holds separate projects (the WinUI/HDR test app): not part of Haku's build -->
    <Compile Remove="tools\**" />
    <Page Remove="tools\**" />
    <ApplicationDefinition Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
  </ItemGroup>
</Project>
